-- 1. CREATE DATABASE

DROP DATABASE IF EXISTS SmartParkingDB;

CREATE DATABASE SmartParkingDB;

USE SmartParkingDB;


-- 2. CREATE PARKING SLOT TABLE

CREATE TABLE ParkingSlot (
    SlotID INT PRIMARY KEY AUTO_INCREMENT,
    SlotNumber VARCHAR(10) UNIQUE NOT NULL,
    SlotType VARCHAR(20) NOT NULL,
    Status VARCHAR(20) DEFAULT 'Available'
);


-- 3. CREATE VEHICLE TABLE

CREATE TABLE Vehicle (
    VehicleID INT PRIMARY KEY AUTO_INCREMENT,
    OwnerName VARCHAR(50) NOT NULL,
    VehicleNumber VARCHAR(20) UNIQUE NOT NULL,
    VehicleType VARCHAR(20) NOT NULL
);


-- 4. CREATE PARKING BOOKING TABLE

CREATE TABLE ParkingBooking (
    BookingID INT PRIMARY KEY AUTO_INCREMENT,
    VehicleID INT NOT NULL,
    SlotID INT NOT NULL,
    EntryTime DATETIME NOT NULL,
    ExitTime DATETIME DEFAULT NULL,
    Amount DECIMAL(10,2) DEFAULT 0.00,
    BookingStatus VARCHAR(20) DEFAULT 'Active',

    FOREIGN KEY (VehicleID)
        REFERENCES Vehicle(VehicleID),

    FOREIGN KEY (SlotID)
        REFERENCES ParkingSlot(SlotID)
);


