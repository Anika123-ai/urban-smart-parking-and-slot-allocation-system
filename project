FROM ParkingSlot
WHERE Status = 'Occupied';


-- 20. CALCULATE TOTAL PARKING REVENUE

SELECT
COALESCE(SUM(Amount), 0) AS TotalRevenue
FROM ParkingBooking
WHERE BookingStatus = 'Completed';


-- 21. FINAL PARKING DASHBOARD

SELECT
    COUNT(*) AS TotalSlots,
    SUM(Status = 'Available') AS AvailableSlots,
    SUM(Status = 'Occupied') AS OccupiedSlots
FROM ParkingSlot;


-- 22. DISPLAY VEHICLE-WISE BOOKING DETAILS

SELECT
    V.OwnerName,
    V.VehicleNumber,
    COUNT(B.BookingID) AS TotalBookings,
    COALESCE(SUM(B.Amount), 0) AS TotalAmount
FROM Vehicle V
LEFT JOIN ParkingBooking B
    ON V.VehicleID = B.VehicleID
GROUP BY V.VehicleID, V.OwnerName, V.VehicleNumber;


