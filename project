-- 11. AUTOMATIC SLOT ALLOCATION
-- Allocate the first available compatible slot
-- to a vehicle using a stored procedure.

DELIMITER //

CREATE PROCEDURE AllocateParking(
    IN p_VehicleID INT
)
BEGIN
    DECLARE v_SlotID INT DEFAULT NULL;
    DECLARE v_VehicleType VARCHAR(20);

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        RESIGNAL;
    END;

    START TRANSACTION;

    SELECT VehicleType
    INTO v_VehicleType
    FROM Vehicle
    WHERE VehicleID = p_VehicleID;

    SELECT SlotID
    INTO v_SlotID
    FROM ParkingSlot
    WHERE SlotType = v_VehicleType
      AND Status = 'Available'
    ORDER BY SlotID
    LIMIT 1
    FOR UPDATE;

    IF v_SlotID IS NULL THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'No parking slot available';
    END IF;

    INSERT INTO ParkingBooking
    (VehicleID, SlotID, EntryTime, BookingStatus)
    VALUES
    (p_VehicleID, v_SlotID, NOW(), 'Active');

    UPDATE ParkingSlot
    SET Status = 'Occupied'
    WHERE SlotID = v_SlotID;

    COMMIT;

    SELECT
        'Parking slot allocated successfully' AS Message,
        v_SlotID AS AllocatedSlotID;

END //

DELIMITER ;


-- 12. CALL ALLOCATION PROCEDURE
-- Example: Allocate slot to VehicleID 1

CALL AllocateParking(1);


-- 13. DISPLAY ACTIVE BOOKINGS

SELECT
    B.BookingID,
    V.OwnerName,
    V.VehicleNumber,
    P.SlotNumber,
    B.EntryTime,
    B.BookingStatus
FROM ParkingBooking B
JOIN Vehicle V
    ON B.VehicleID = V.VehicleID
JOIN ParkingSlot P
    ON B.SlotID = P.SlotID
WHERE B.BookingStatus = 'Active';


-- 14. VEHICLE EXIT AND FEE CALCULATION
-- Parking rate = Rs. 30 per started hour.

DELIMITER //

CREATE PROCEDURE VehicleExit(
    IN p_BookingID INT
)
BEGIN
    DECLARE v_SlotID INT;
    DECLARE v_EntryTime DATETIME;
    DECLARE v_Amount DECIMAL(10,2);

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        RESIGNAL;
    END;

    START TRANSACTION;

    SELECT SlotID, EntryTime
    INTO v_SlotID, v_EntryTime
    FROM ParkingBooking
    WHERE BookingID = p_BookingID
      AND BookingStatus = 'Active'
    FOR UPDATE;

    SET v_Amount =
        CEIL(TIMESTAMPDIFF(
            MINUTE, v_EntryTime, NOW()
        ) / 60.0) * 30;

    UPDATE ParkingBooking
    SET ExitTime = NOW(),
        Amount = v_Amount,
        BookingStatus = 'Completed'
    WHERE BookingID = p_BookingID;

    UPDATE ParkingSlot
    SET Status = 'Available'
    WHERE SlotID = v_SlotID;

    COMMIT;

    SELECT
        'Vehicle exit completed' AS Message,
        v_Amount AS ParkingFee;

END //

DELIMITER ;


-- 15. CALL VEHICLE EXIT PROCEDURE
-- Example: Complete BookingID 1

CALL VehicleExit(1);


